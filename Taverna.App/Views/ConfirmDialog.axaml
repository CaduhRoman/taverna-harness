<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Taverna.App.Views.ConfirmDialog"
        Title="Confirm" Width="400" SizeToContent="Height" CanResize="False"
        SystemDecorations="BorderOnly" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Icon="/Assets/taverna-icon.png" Background="{DynamicResource Brush.Overlay}">
  <Border BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1">
    <StackPanel Margin="20,18,20,16" Spacing="6">
      <TextBlock Name="Heading" FontSize="{DynamicResource FontSize.Ui}" FontWeight="SemiBold"
                 Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" />
      <TextBlock Name="Message" Classes="body" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
        <Button Content="Cancel" IsCancel="True" IsDefault="True" Click="OnCancel" />
        <Button Name="ConfirmButton" Classes="accent" Click="OnConfirm" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
