<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Taverna.App.Views.UnsavedChangesDialog"
        Title="Unsaved Changes" Width="420" SizeToContent="Height" CanResize="False"
        SystemDecorations="BorderOnly" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Icon="/Assets/taverna-icon.png" Background="{DynamicResource Brush.Overlay}">
  <Border BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1">
    <StackPanel Margin="20,18,20,16" Spacing="6">
      <TextBlock Name="Heading" FontSize="{DynamicResource FontSize.Ui}" FontWeight="SemiBold"
                 Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" />
      <TextBlock Classes="body" Text="Your changes will be lost if you don't save them." TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
        <Button Content="Don't Save" Click="OnDiscard" />
        <Button Content="Cancel" IsCancel="True" Click="OnCancel" />
        <Button Content="Save" IsDefault="True" Classes="accent" Click="OnSave" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
