<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Taverna.App.ViewModels"
        xmlns:views="using:Taverna.App.Views"
        x:Class="Taverna.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel" x:CompileBindings="True"
        Title="{Binding WindowTitle}" Icon="/Assets/taverna-icon.png"
        Width="1440" Height="860" MinWidth="940" MinHeight="550" WindowStartupLocation="CenterScreen"
        Padding="{Binding $self.OffScreenMargin}"
        Background="{DynamicResource Brush.Window}" Foreground="{DynamicResource Brush.Text}">
  <Window.Styles>
    <Style Selector="TreeViewItem" x:DataType="vm:FileNodeViewModel">
      <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto,Auto">
    <!-- Top bar: identity, navigation, global actions -->
    <Grid Name="TopBar" Height="{DynamicResource Size.TopBar}" ColumnDefinitions="*,Auto,*" Margin="14,0,8,0">
      <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
        <Image Source="/Assets/taverna-mark.png" Height="17" RenderOptions.BitmapInterpolationMode="HighQuality" />
        <TextBlock Text="Taverna" FontSize="{DynamicResource FontSize.Ui}" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBlock Text="/" Classes="muted" VerticalAlignment="Center" IsVisible="{Binding HasProject}" />
        <TextBlock Text="{Binding ProjectTitle}" Classes="body" VerticalAlignment="Center" IsVisible="{Binding HasProject}"
                   MaxWidth="260" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ProjectDirectory}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
        <Border Classes="nav active">
          <TextBlock Text="Editor" />
        </Border>
        <Border Classes="nav" ToolTip.Tip="Coming soon">
          <TextBlock Text="Office" />
        </Border>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="2">
        <Button Theme="{StaticResource IconButton}" Command="{Binding OpenFolderCommand}" ToolTip.Tip="Open Folder (Ctrl+O)">
          <Path Classes="icon" Data="{StaticResource Icon.OpenFolder}" />
        </Button>
        <Button Theme="{StaticResource IconButton}" Command="{Binding SplitEditorCommand}" ToolTip.Tip="Split Right (Ctrl+\)">
          <Path Classes="icon" Data="{StaticResource Icon.Split}" />
        </Button>
        <Border Width="1" Height="16" Margin="6,0" Background="{DynamicResource Brush.BorderStrong}" />
        <ToggleButton Theme="{StaticResource IconToggle}" IsChecked="{Binding IsExplorerVisible, Mode=TwoWay}"
                      ToolTip.Tip="Toggle Explorer (Ctrl+B)">
          <Path Classes="icon" Data="{StaticResource Icon.PanelLeft}" />
        </ToggleButton>
        <ToggleButton Theme="{StaticResource IconToggle}" IsChecked="{Binding IsChatVisible, Mode=TwoWay}"
                      ToolTip.Tip="Toggle Chat (Ctrl+Alt+B)">
          <Path Classes="icon" Data="{StaticResource Icon.PanelRight}" />
        </ToggleButton>
      </StackPanel>
    </Grid>

    <!-- Workbench: explorer | editor splits | chat -->
    <Grid Name="Workbench" Grid.Row="1" ColumnDefinitions="260,Auto,*,Auto,340" Margin="6,0">
      <Border Name="ExplorerPanel" Classes="island">
        <Grid RowDefinitions="Auto,Auto,Auto,*">
          <Grid Height="{DynamicResource Size.PanelHeader}" ColumnDefinitions="*,Auto" Margin="12,0,5,0">
            <TextBlock Classes="title" Text="Files" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" IsVisible="{Binding HasProject}">
              <Button Theme="{StaticResource IconButton}" Command="{Binding BeginNewFileCommand}" ToolTip.Tip="New File (Ctrl+N)">
                <Path Classes="icon" Data="{StaticResource Icon.NewFile}" />
              </Button>
              <Button Theme="{StaticResource IconButton}" Command="{Binding BeginNewFolderCommand}" ToolTip.Tip="New Folder">
                <Path Classes="icon" Data="{StaticResource Icon.NewFolder}" />
              </Button>
              <Button Theme="{StaticResource IconButton}" Command="{Binding RefreshCommand}" ToolTip.Tip="Refresh">
                <Path Classes="icon" Data="{StaticResource Icon.Refresh}" />
              </Button>
              <Button Theme="{StaticResource IconButton}" Command="{Binding CollapseAllCommand}" ToolTip.Tip="Collapse All">
                <Path Classes="icon" Data="{StaticResource Icon.CollapseAll}" />
              </Button>
            </StackPanel>
          </Grid>

          <!-- Browsing a task worktree: always say which tree is being edited. -->
          <Border Grid.Row="1" Classes="card" Margin="8,0,8,6" Padding="8,5" IsVisible="{Binding IsBrowsingWorktree}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Path Classes="icon" Data="{StaticResource Icon.Branch}" Margin="0,0,6,0" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Classes="status" Text="Worktree" />
                <TextBlock Text="{Binding BrowsedTask.Branch, FallbackValue={x:Null}}" FontSize="{DynamicResource FontSize.Body}"
                           TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding BrowsedTask.WorktreePath, FallbackValue={x:Null}}" />
              </StackPanel>
              <Button Grid.Column="2" Theme="{StaticResource SubtleButton}" Content="Project" Padding="8,3"
                      Command="{Binding ReturnToProjectCommand}" ToolTip.Tip="Back to the project tree" />
            </Grid>
          </Border>

          <TextBox Name="NewEntryBox" Grid.Row="2" Classes="inline" Margin="8,0,8,6"
                   Text="{Binding NewEntryName, Mode=TwoWay}" Watermark="{Binding NewEntryHint}"
                   IsVisible="{Binding IsCreatingEntry}" />

          <TreeView Name="FileTree" Grid.Row="3" Classes="explorer" Margin="5,0,5,6"
                    ItemsSource="{Binding RootNodes}" SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding HasProject}">
            <TreeView.ItemTemplate>
              <TreeDataTemplate DataType="vm:FileNodeViewModel" ItemsSource="{Binding Children}">
                <Grid ColumnDefinitions="14,Auto,*" Background="Transparent" Tapped="OnTreeRowTapped">
                  <Path Classes="icon chevron" Classes.expanded="{Binding IsExpanded}" Data="{StaticResource Icon.Chevron}"
                        IsVisible="{Binding IsDirectory}" Width="14" Height="16" HorizontalAlignment="Left"
                        RenderTransformOrigin="8,8" Margin="-3,0,0,0" />
                  <Path Grid.Column="1" Classes="icon file" Classes.folder="{Binding IsDirectory}"
                        Data="{Binding IconKey, Converter={StaticResource FileIcon}}" Margin="0,0,7,0" />
                  <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
              </TreeDataTemplate>
            </TreeView.ItemTemplate>
          </TreeView>

          <StackPanel Grid.Row="3" Margin="12,4,12,0" Spacing="10" IsVisible="{Binding !HasProject}">
            <TextBlock Classes="muted" Text="No folder open." />
            <Button Theme="{StaticResource SubtleButton}" Command="{Binding OpenFolderCommand}" Margin="-8,0"
                    HorizontalAlignment="Stretch">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Path Classes="icon" Data="{StaticResource Icon.OpenFolder}" Margin="0,0,8,0" />
                <TextBlock Grid.Column="1" Text="Open Folder…" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Classes="kbd" Text="Ctrl+O" />
              </Grid>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <GridSplitter Name="ExplorerSplitter" Grid.Column="1" Classes="gap" />

      <Grid Name="EditorGrid" Grid.Column="2" ColumnDefinitions="*,Auto,0">
        <views:EditorPaneView Name="PrimaryPaneView" DataContext="{Binding PrimaryPane}" />
        <GridSplitter Name="EditorSplitter" Grid.Column="1" Classes="gap" IsVisible="False" />
        <views:EditorPaneView Name="SecondaryPaneView" Grid.Column="2" DataContext="{Binding SecondaryPane}" IsVisible="False" />
      </Grid>

      <GridSplitter Name="ChatSplitter" Grid.Column="3" Classes="gap" />

      <!-- Chat and the task orchestrator share the right panel. -->
      <Border Name="ChatPanel" Grid.Column="4" Classes="island">
        <Grid RowDefinitions="Auto,*">
          <Grid Height="{DynamicResource Size.PanelHeader}" ColumnDefinitions="Auto,Auto,*" Margin="6,0,6,0">
            <Button Theme="{StaticResource SubtleButton}" Classes="paneltab" Classes.active="{Binding !ShowTasks}"
                    Content="Chat" Command="{Binding ShowChatPanelCommand}" />
            <Button Grid.Column="1" Theme="{StaticResource SubtleButton}" Classes="paneltab" Classes.active="{Binding ShowTasks}"
                    Command="{Binding ShowTasksPanelCommand}" Margin="2,0,0,0">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="Tasks" />
                <TextBlock Classes="status" Text="{Binding Tasks.HeaderBadge}" />
              </StackPanel>
            </Button>
          </Grid>
          <views:ChatPanelView Grid.Row="1" Name="ChatView" DataContext="{Binding Chat}"
                               IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowTasks, Converter={x:Static BoolConverters.Not}}" />
          <views:TasksPanelView Grid.Row="1" DataContext="{Binding Tasks}" IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowTasks}" />
        </Grid>
      </Border>
    </Grid>

    <!-- Error bar: one line, dismissible, clears itself. -->
    <Border Grid.Row="2" Classes="errorbar" Margin="6,6,6,0"
            IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Ellipse Classes="dot error" Margin="2,0,10,0" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" FontSize="{DynamicResource FontSize.Body}"
                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip.Tip="{Binding ErrorMessage}" />
        <Button Grid.Column="2" Theme="{StaticResource TabCloseButton}" Command="{Binding DismissErrorCommand}" ToolTip.Tip="Dismiss">
          <Path Classes="icon" Data="{StaticResource Icon.Close}" />
        </Button>
      </Grid>
    </Border>

    <!-- Status bar -->
    <Grid Grid.Row="3" Height="{DynamicResource Size.StatusBar}" ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" Margin="14,0">
      <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,14,0">
        <TextBlock Classes="status" Text="{Binding ProjectTitle}" />
        <TextBlock Classes="status" Text="· worktree" Foreground="{DynamicResource Brush.Text}" IsVisible="{Binding IsBrowsingWorktree}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="0,0,14,0"
                  IsVisible="{Binding GitBranch, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Path Classes="icon" Data="{StaticResource Icon.Branch}" Stroke="{DynamicResource Brush.TextMuted}"
              VerticalAlignment="Center" RenderTransform="scale(0.8)" />
        <TextBlock Classes="status" Text="{Binding GitBranch}" />
      </StackPanel>
      <TextBlock Grid.Column="2" Classes="status" Text="{Binding Status}" TextTrimming="CharacterEllipsis" Margin="0,0,14,0" />
      <TextBlock Grid.Column="3" Classes="status" Text="{Binding ActiveFilePath}" TextTrimming="LeadingCharacterEllipsis"
                 MaxWidth="420" Margin="0,0,16,0" />
      <TextBlock Grid.Column="4" Classes="status" Text="{Binding ActiveDocument.CaretLabel, FallbackValue={x:Null}}" Margin="0,0,16,0" />
      <TextBlock Grid.Column="5" Classes="status" Text="{Binding ActiveDocument.Language.DisplayName, FallbackValue={x:Null}}" />
    </Grid>
  </Grid>
</Window>
