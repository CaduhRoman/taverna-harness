<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Taverna.App.ViewModels"
             x:Class="Taverna.App.Views.TasksPanelView"
             xmlns:git="using:Taverna.Core.Git"
             x:DataType="vm:TasksViewModel" x:CompileBindings="True">
  <UserControl.Styles>
    <!-- Form controls follow the app rhythm: 26px rows, control radius, body text. -->
    <Style Selector="Grid.taskForm TextBlock.label">
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    </Style>
    <Style Selector="Grid.taskForm ComboBox">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="8,3,0,3" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
    </Style>
    <Style Selector="Grid.taskForm CheckBox">
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
      <Setter Property="MinHeight" Value="26" />
    </Style>
    <Style Selector="Button.formAction">
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto,*">
    <!-- Toolbar -->
    <Grid ColumnDefinitions="*,Auto" Margin="12,2,8,6" IsVisible="{Binding !IsCreating}">
      <TextBlock Classes="muted" VerticalAlignment="Center"
                 Text="{Binding ActiveCount, StringFormat='{}{0} running · max 3'}" />
      <Button Grid.Column="1" Theme="{StaticResource SubtleButton}" Command="{Binding BeginCreateCommand}"
              IsEnabled="{Binding HasProject}" ToolTip.Tip="New Task">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Path Classes="icon" Data="{StaticResource Icon.Plus}" />
          <TextBlock Text="New Task" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </Grid>

    <!-- New Task form: fills the popover while open. -->
    <Grid Classes="taskForm" Grid.RowSpan="3" IsVisible="{Binding IsCreating}" RowDefinitions="Auto,Auto,*,Auto,Auto">
      <Grid Height="{DynamicResource Size.PanelHeader}" ColumnDefinitions="*,Auto" Margin="12,0,6,0">
        <TextBlock Classes="title" Text="New Task" />
        <Button Grid.Column="1" Theme="{StaticResource IconButton}" Command="{Binding CancelCreateCommand}"
                ToolTip.Tip="Close" AutomationProperties.Name="Close New Task">
          <Path Classes="icon" Data="{StaticResource Icon.Close}" />
        </Button>
      </Grid>
      <Border Grid.Row="1" Classes="divider" />

      <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12,10,12,12" Spacing="12" IsEnabled="{Binding !IsStarting}">
          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="Title" />
            <TextBox Classes="inline" Text="{Binding NewTitle}" Watermark="e.g. Add tab drag and drop" MaxLength="80" />
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="Agent" />
            <ComboBox ItemsSource="{Binding AgentOptions}" SelectedItem="{Binding NewAgent}" AutomationProperties.Name="Agent">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="vm:AgentOptionViewModel">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{Binding Name}" />
                    <TextBlock Classes="status" Text="{Binding AvailabilityText}" IsVisible="{Binding !IsAvailable}" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="Model" />
            <ComboBox ItemsSource="{Binding ModelChoices}" SelectedItem="{Binding SelectedModelChoice}" AutomationProperties.Name="Model">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="vm:ChoiceViewModel">
                  <TextBlock Text="{Binding Label}" ToolTip.Tip="{Binding Value}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <StackPanel Spacing="4" IsVisible="{Binding NewAgentSupportsEffort}">
            <TextBlock Classes="label" Text="Effort" />
            <ItemsControl ItemsSource="{Binding EffortChoices}" AutomationProperties.Name="Effort">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:ChoiceViewModel">
                  <Button Theme="{StaticResource SubtleButton}" Classes="chip" Classes.active="{Binding IsSelected}"
                          Content="{Binding Label}"
                          Command="{Binding $parent[UserControl].((vm:TasksViewModel)DataContext).SelectEffortChoiceCommand}"
                          CommandParameter="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="Prompt" />
            <TextBox Classes="inline" Text="{Binding NewPrompt}" Watermark="Describe the task in as much detail as possible…"
                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" MaxHeight="280" VerticalContentAlignment="Top" />
            <ItemsControl ItemsSource="{Binding ContextAttachments}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:AttachmentViewModel">
                  <Border Classes="thumb" Margin="0,4,6,0" ToolTip.Tip="{Binding FileName}">
                    <Panel>
                      <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                      <Button Theme="{StaticResource TabCloseButton}" Classes="thumbclose" HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip.Tip="Remove"
                              Command="{Binding $parent[UserControl].((vm:TasksViewModel)DataContext).RemoveContextCommand}"
                              CommandParameter="{Binding}">
                        <Path Classes="icon" Data="{StaticResource Icon.Close}" />
                      </Button>
                    </Panel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Theme="{StaticResource SubtleButton}" HorizontalAlignment="Left" Command="{Binding AddContextCommand}"
                    IsVisible="{Binding CanAddContext}" ToolTip.Tip="Attach an image to the task prompt">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Path Classes="icon" Data="{StaticResource Icon.Image}" />
                <TextBlock Text="Attach image" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>

          <TextBlock Classes="status" Text="{Binding NewAgentHint}" TextWrapping="Wrap"
                     IsVisible="{Binding NewAgentHint, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="3" Classes="divider" />
      <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto" Margin="12,8" IsEnabled="{Binding !IsStarting}">
        <CheckBox Content="Start now" IsChecked="{Binding StartAfterCreate}" VerticalAlignment="Center"
                  ToolTip.Tip="Uncheck to queue the task and start it later from the list." />
        <Button Grid.Column="1" Classes="formAction" Content="Cancel" Command="{Binding CancelCreateCommand}" Margin="0,0,6,0" />
        <Button Grid.Column="2" Classes="formAction accent" Content="Create" Command="{Binding CreateCommand}" />
      </Grid>
    </Grid>
    <!-- Task list -->
    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding !IsCreating}">
      <StackPanel Margin="6,0,6,8">
        <TextBlock Classes="muted" Margin="6,6" Text="No tasks yet." IsVisible="{Binding HasNoTasks}" />
        <ItemsControl ItemsSource="{Binding Tasks}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:TaskItemViewModel">
              <StackPanel Margin="0,0,0,2">
                <Button Theme="{StaticResource SubtleButton}" HorizontalAlignment="Stretch" Padding="8,6"
                        Command="{Binding $parent[UserControl].((vm:TasksViewModel)DataContext).ToggleExpandCommand}"
                        CommandParameter="{Binding}">
                  <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                    <Ellipse Classes="dot" Classes.working="{Binding IsWorking}" Classes.error="{Binding IsErrorState}"
                             Classes.done="{Binding IsDoneState}" Margin="0,0,9,0" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Classes="status" Margin="8,0,0,0"
                               Text="{Binding StatusText}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="status" Text="{Binding Meta}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Classes="status" Margin="8,0,0,0" Text="{Binding DurationText}" />
                  </Grid>
                </Button>

                <Border Classes="card" Margin="2,2,2,8" IsVisible="{Binding IsExpanded}">
                  <StackPanel Spacing="8">
                    <TextBlock Classes="body" Text="{Binding Detail}" TextWrapping="Wrap" IsVisible="{Binding HasDetail}" />
                    <ItemsControl ItemsSource="{Binding ConflictFiles}" IsVisible="{Binding HasConflict}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                          <TextBlock Classes="kbd" Text="{Binding}" Foreground="{DynamicResource Brush.Text}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" Classes="meta">
                      <TextBlock Classes="status" Text="Base" />
                      <TextBlock Grid.Column="1" Classes="kbd" Text="{Binding BaseCommit}" Margin="10,0,0,0" />
                      <TextBlock Grid.Row="1" Classes="status" Text="Tokens" />
                      <TextBlock Grid.Row="1" Grid.Column="1" Classes="status" Text="{Binding TokensText}" Margin="10,0,0,0" />
                      <TextBlock Grid.Row="2" Classes="status" Text="Files" />
                      <TextBlock Grid.Row="2" Grid.Column="1" Classes="status" Text="{Binding FilesText}" Margin="10,0,0,0" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding ChangedFiles}" IsVisible="{Binding HasChangedFiles}" MaxHeight="140">
                      <ItemsControl.Template>
                        <ControlTemplate>
                          <ScrollViewer><ItemsPresenter /></ScrollViewer>
                        </ControlTemplate>
                      </ItemsControl.Template>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="git:GitFileChange">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="kbd" Text="{Binding Status}" Width="18" />
                            <TextBlock Classes="kbd" Text="{Binding Path}" Foreground="{DynamicResource Brush.TextSecondary}"
                                       TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <WrapPanel Orientation="Horizontal">
                      <Button Content="Start" IsVisible="{Binding IsQueued}" IsEnabled="{Binding !IsBusy}" Margin="0,0,6,0"
                              Command="{Binding $parent[UserControl].((vm:TasksViewModel)DataContext).StartQueuedCommand}" CommandParameter="{Binding}" />
                      <Button Content="Open" Margin="0,0,6,0" IsEnabled="{Binding CanOpen}" ToolTip.Tip="Show the worktree in the explorer"
                              Command="{Binding $parent[UserControl].((vm:TasksViewModel)DataContext).OpenCommand}" CommandParameter="{Binding}" />
                      <Button Content="Merge" Margin="0,0,6,0" IsEnabled="{Binding CanMerge}"
                              Command="{Binding $parent[UserControl].((vm:TasksViewModel)DataContext).MergeCommand}" CommandParameter="{Binding}" />
                      <Button Content="Discard" Margin="0,0,6,0" IsEnabled="{Binding CanDiscard}"
                              Command="{Binding $parent[UserControl].((vm:TasksViewModel)DataContext).DiscardCommand}" CommandParameter="{Binding}" />
                      <Button Content="Cancel" IsVisible="{Binding IsWorking}" IsEnabled="{Binding CanCancel}"
                              Command="{Binding $parent[UserControl].((vm:TasksViewModel)DataContext).CancelTaskCommand}" CommandParameter="{Binding}" />
                    </WrapPanel>

                    <TextBox Classes="log" Text="{Binding Log}" IsReadOnly="True" TextWrapping="Wrap"
                             Height="200" TextChanged="OnLogChanged" />
                  </StackPanel>
                </Border>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
