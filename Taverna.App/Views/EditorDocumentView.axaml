<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:edit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit"
             x:Class="Taverna.App.Views.EditorDocumentView">
  <edit:TextEditor Name="CodeEditor" Background="Transparent" Foreground="{DynamicResource Brush.Editor.Text}"
                   FontFamily="{DynamicResource Font.Code}" FontSize="{DynamicResource FontSize.Code}"
                   LineNumbersForeground="{DynamicResource Brush.Editor.LineNumber}"
                   ShowLineNumbers="True" Padding="0,6,0,0"
                   HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
</UserControl>
