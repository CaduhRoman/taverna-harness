<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Taverna.App.Converters"
             x:Class="Taverna.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Styles/Tokens.axaml" />
        <ResourceInclude Source="/Styles/Icons.axaml" />
        <ResourceInclude Source="/Styles/Themes.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <conv:FileIconConverter x:Key="FileIcon" />
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme DensityStyle="Compact">
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#FFC8C8CC" RegionColor="#FF0A0A0B" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <StyleInclude Source="/Styles/Controls.axaml" />
  </Application.Styles>
</Application>
