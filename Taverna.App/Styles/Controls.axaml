<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Icons follow the inherited foreground so buttons can tint them on hover. -->
  <Style Selector="Path.icon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Stretch" Value="None" />
    <Setter Property="StrokeThickness" Value="1.2" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="StrokeJoin" Value="Round" />
    <Setter Property="Stroke" Value="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
  </Style>
  <Style Selector="Path.icon.file">
    <Setter Property="Stroke" Value="{DynamicResource Brush.Icon}" />
  </Style>
  <Style Selector="Path.icon.folder">
    <Setter Property="Stroke" Value="{DynamicResource Brush.IconStrong}" />
    <Setter Property="Fill" Value="{DynamicResource Brush.IconFolderFill}" />
  </Style>
  <Style Selector="Path.chevron">
    <Setter Property="Stroke" Value="{DynamicResource Brush.TextMuted}" />
    <Setter Property="RenderTransform" Value="rotate(0deg)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.08" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Path.chevron.expanded">
    <Setter Property="RenderTransform" Value="rotate(90deg)" />
  </Style>

  <!-- Surfaces -->
  <Style Selector="Border.island">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Island}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Brush.Border}" />
  </Style>

  <!-- Splitters are the gaps between islands: invisible until hovered. -->
  <Style Selector="GridSplitter.gap">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="MinWidth" Value="{DynamicResource Size.Gap}" />
    <Setter Property="ResizeDirection" Value="Columns" />
    <Setter Property="Focusable" Value="False" />
  </Style>
  <Style Selector="GridSplitter.gap:pointerover">
    <Setter Property="Background" Value="{DynamicResource Brush.SplitterHover}" />
  </Style>

  <!-- Typography -->
  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
  </Style>
  <Style Selector="TextBlock.status">
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.kbd">
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    <Setter Property="FontFamily" Value="{DynamicResource Font.Code}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Top bar navigation -->
  <Style Selector="Border.nav">
    <Setter Property="Padding" Value="12,4" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
  </Style>
  <Style Selector="Border.nav > TextBlock">
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
  </Style>
  <Style Selector="Border.nav.active">
    <Setter Property="Background" Value="{DynamicResource Brush.Raised}" />
  </Style>
  <Style Selector="Border.nav.active > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>

  <Style Selector="TextBox.inline">
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
  </Style>

  <Style Selector="TreeView.explorer">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Ui}" />
  </Style>

  <!-- Tab close slot: dot while modified, close button on hover or for the active clean tab. -->
  <Style Selector="Panel.closeslot > Button">
    <Setter Property="Opacity" Value="0" />
  </Style>
  <Style Selector="ListBoxItem:selected Panel.closeslot:not(.modified) > Button">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="ListBoxItem:pointerover Panel.closeslot > Button">
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Panel.closeslot > Ellipse">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Panel.closeslot.modified > Ellipse">
    <Setter Property="IsVisible" Value="True" />
  </Style>
  <Style Selector="ListBoxItem:pointerover Panel.closeslot > Ellipse">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- Inset surface for forms and expanded task details. -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Brush.Raised}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
    <Setter Property="Padding" Value="10" />
  </Style>

  <!-- Status dots: solid = done, hollow = error/conflict, pulsing = working. -->
  <Style Selector="Ellipse.dot">
    <Setter Property="Width" Value="7" />
    <Setter Property="Height" Value="7" />
    <Setter Property="Fill" Value="{DynamicResource Brush.TextMuted}" />
  </Style>
  <Style Selector="Ellipse.dot.done">
    <Setter Property="Fill" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>
  <Style Selector="Ellipse.dot.error">
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="Stroke" Value="{DynamicResource Brush.Text}" />
    <Setter Property="StrokeThickness" Value="1.4" />
  </Style>
  <Style Selector="Ellipse.dot.ready">
    <Setter Property="Fill" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>
  <Style Selector="Ellipse.dot.unavailable">
    <Setter Property="Fill" Value="Transparent" />
    <Setter Property="Stroke" Value="{DynamicResource Brush.TextMuted}" />
    <Setter Property="StrokeThickness" Value="1" />
  </Style>
  <Style Selector="Ellipse.dot.working">
    <Setter Property="Fill" Value="{DynamicResource Brush.Text}" />
    <Style.Animations>
      <Animation Duration="0:0:1.2" IterationCount="Infinite" PlaybackDirection="Alternate">
        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.25" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector="TextBox.log">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Code}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
    <Setter Property="Padding" Value="8,6" />
  </Style>

  <Style Selector="Border.errorbar">
    <Setter Property="Background" Value="{DynamicResource Brush.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
    <Setter Property="Padding" Value="10,5,6,5" />
  </Style>

  <!-- Chat -->
  <Style Selector="Border.message">
    <Setter Property="Padding" Value="0,6" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <Style Selector="Border.message.user">
    <Setter Property="Background" Value="{DynamicResource Brush.Raised}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
    <Setter Property="Padding" Value="10,7" />
  </Style>
  <Style Selector="Border.composer">
    <Setter Property="Background" Value="{DynamicResource Brush.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Island}" />
    <Setter Property="Padding" Value="8,6" />
  </Style>
  <Style Selector="Border.composer:focus-within">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
  </Style>
  <!-- The composer box is borderless; its card provides the frame. -->
  <Style Selector="TextBox.composer">
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Ui}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4,4" />
    <Setter Property="MinHeight" Value="40" />
  </Style>
  <Style Selector="TextBox.composer:pointerover /template/ Border#PART_BorderElement, TextBox.composer:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Border.thumb">
    <Setter Property="Width" Value="64" />
    <Setter Property="Height" Value="48" />
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.thumbclose">
    <Setter Property="Background" Value="#B30A0A0B" />
    <Setter Property="Margin" Value="2" />
  </Style>
  <Style Selector="Button.chip">
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="Margin" Value="0,0,4,4" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
  </Style>
  <Style Selector="Button.chip.active">
    <Setter Property="Background" Value="{DynamicResource Brush.SelectedFocus}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
  </Style>
  <Style Selector="FlyoutPresenter">
    <Setter Property="Background" Value="{DynamicResource Brush.Overlay}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
    <Setter Property="Padding" Value="4,6" />
  </Style>

  <!-- Right panel switcher (Chat | Tasks) -->
  <Style Selector="Button.paneltab">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.paneltab.active">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Raised}" />
  </Style>

  <!-- An unfocused split keeps its current tab visible, but quieter. -->
  <Style Selector="Border.pane:not(.active) ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource Brush.Selected}" />
  </Style>
</Styles>
